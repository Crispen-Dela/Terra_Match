{
  "name": "terramatch-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"cd server && node --watch src/server.js\" \"vite\"",
    "dev:backend": "cd server && node --watch src/server.js",
    "dev:frontend": "vite",
    "setup": "npm install && cd server && npm install && npx prisma db push && node prisma/seed.js",
    "db:push": "cd server && npx prisma db push",
    "db:seed": "cd server && node prisma/seed.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "stream-chat": "^9.51.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
